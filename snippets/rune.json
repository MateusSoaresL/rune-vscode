{
    "Print": {
        "prefix": "print",
        "body": [
            "print(${1});"
        ],
        "description": "Print a value"
    },

    "Println": {
        "prefix": "println",
        "body": [
            "println(${1});"
        ],
        "description": "Print a value followed by a newline"
    },

    "Input": {
        "prefix": "input",
        "body": [
            "io.input(${1:\"Prompt: \"})"
        ],
        "description": "Read input from stdin"
    },

    "Input Without Prompt": {
        "prefix": "inputempty",
        "body": [
            "io.input()"
        ],
        "description": "Read input from stdin without a prompt"
    },

    "Let Variable": {
        "prefix": "let",
        "body": [
            "let ${1:name}: ${2:i32} = ${3:0};"
        ],
        "description": "Declare an immutable variable"
    },

    "Mutable Variable": {
        "prefix": "var",
        "body": [
            "var ${1:name}: ${2:i32} = ${3:0};"
        ],
        "description": "Declare a mutable variable"
    },

    "If": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Create an if statement"
    },

    "If Else": {
        "prefix": "ifelse",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "} else {",
            "    ${3}",
            "}"
        ],
        "description": "Create an if/else statement"
    },

    "If Else If Else": {
        "prefix": "ifelseif",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "} else if ${3:condition} {",
            "    ${4}",
            "} else {",
            "    ${5}",
            "}"
        ],
        "description": "Create an if/else if/else statement"
    },

    "While": {
        "prefix": "while",
        "body": [
            "while ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Create a while loop"
    },

    "For": {
        "prefix": "for",
        "body": [
            "for var ${1:i}: i32 = ${2:0}; ${1:i} < ${3:10}; ${1:i} = ${1:i} + 1 {",
            "    ${4}",
            "}"
        ],
        "description": "Create a for loop"
    },

    "Function": {
        "prefix": "function",
        "body": [
            "function ${1:name}(${2}): ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Declare a function"
    },

    "Function With Parameter": {
        "prefix": "functionparam",
        "body": [
            "function ${1:name}(${2:value}: ${3:i32}): ${4:void} {",
            "    ${5}",
            "}"
        ],
        "description": "Declare a function with a parameter"
    },

    "Function Return": {
        "prefix": "functionreturn",
        "body": [
            "function ${1:name}(${2:value}: ${3:i32}): ${4:i32} {",
            "    return ${5:value};",
            "}"
        ],
        "description": "Declare a function with a return value"
    },

    "Return": {
        "prefix": "return",
        "body": [
            "return ${1};"
        ],
        "description": "Return a value from a function"
    },

    "Break": {
        "prefix": "break",
        "body": [
            "break;"
        ],
        "description": "Break out of a loop"
    },

    "Continue": {
        "prefix": "continue",
        "body": [
            "continue;"
        ],
        "description": "Continue to the next loop iteration"
    },

    "Block": {
        "prefix": "block",
        "body": [
            "{",
            "    ${1}",
            "}"
        ],
        "description": "Create a lexical scope block"
    },

    "String Variable": {
        "prefix": "letstring",
        "body": [
            "let ${1:name}: string = \"${2:value}\";"
        ],
        "description": "Declare a string variable"
    },

    "Boolean Variable": {
        "prefix": "letbool",
        "body": [
            "let ${1:name}: bool = ${2:true};"
        ],
        "description": "Declare a boolean variable"
    },

    "Integer Variable": {
        "prefix": "leti32",
        "body": [
            "let ${1:name}: i32 = ${2:0};"
        ],
        "description": "Declare an i32 variable"
    },

    "Float Variable": {
        "prefix": "letf64",
        "body": [
            "let ${1:name}: f64 = ${2:0.0};"
        ],
        "description": "Declare an f64 variable"
    },

    "Character Variable": {
        "prefix": "letchar",
        "body": [
            "let ${1:name}: char = '${2:a}';"
        ],
        "description": "Declare a char variable"
    }
}