{
    "Function": {
        "prefix": "function",
        "body": [
            "function ${1:name}(${2}): ${3:void} {",
            "    ${4}",
            "}"
        ],
        "description": "Create a Rune function"
    },
    "If": {
        "prefix": "if",
        "body": [
            "if ${1:condition} {",
            "    ${2}",
            "}"
        ],
        "description": "Rune if statement"
    },
    "While": {
        "prefix": "while",
        "body": [
            "while ${1:condition} {",
            "    ${2}",
            "}"
        ]
    },
    "For": {
        "prefix": "for",
        "body": [
            "for var ${1:i}: i32 = 0; ${1:i} < ${2:10}; ${1:i} = ${1:i} + 1 {",
            "    ${3}",
            "}"
        ]
    },
    "Print": {
        "prefix": "print",
        "body": [
            "print(${1});"
        ]
    },
    "Println": {
        "prefix": "println",
        "body": [
            "println(${1});"
        ]
    }
}